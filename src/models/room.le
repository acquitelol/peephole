global pub;

fn gen_room() {
	model := rl::load_model("assets/cube3.glb");
    scale_model_uv(&model, [#[2, 4], #[8, 8], #[8, 8]]);

    textures := #["Plaster-2K", "Plaster2", "Planks"];

    for i := 1; i < model.materialCount; i += 1 {
        mat := &model.materials[i];
        asset := textures[i - 1];

        albedo := rl::load_texture("assets/{}/color.png".format(asset));
        normal := rl::load_texture("assets/{}/normal_gl.png".format(asset));
        roughness := rl::load_texture("assets/{}/roughness.png".format(asset));

        rl::set_texture_wrap(albedo, TextureWrap::TEXTURE_WRAP_REPEAT);
        rl::set_texture_wrap(normal, TextureWrap::TEXTURE_WRAP_REPEAT);
        rl::set_texture_wrap(roughness, TextureWrap::TEXTURE_WRAP_REPEAT);

        rl::set_material_texture(mat, MaterialMapIndex::MATERIAL_MAP_DIFFUSE, albedo);
        rl::set_material_texture(mat, MaterialMapIndex::MATERIAL_MAP_NORMAL, normal);
        rl::set_material_texture(mat, MaterialMapIndex::MATERIAL_MAP_SPECULAR, roughness);
    }

    return model;
}