use std/prelude;
use std/raylib;

use lib/index;
use events/index;
use models/index;
use animation/index;

fn main() {
    rl::init_window(0, 0, "dear lover, dear heart, glass heart");
    defer rl::close_window();
    
    rl::set_config_flags(ConfigFlags::FLAG_MSAA_4X_HINT);
    rl::toggle_fullscreen();
    rl::disable_cursor();
    rl::set_target_fps(60);

    rl::init_audio_device();
    defer rl::close_audio_device();

    footsteps := rl::load_music_stream("assets/footsteps.mp3");
    rl::play_music_stream(footsteps);

    texture_gen := fn()
        rl::load_render_texture(rl::get_render_width(), rl::get_render_height());

    front := texture_gen();
    back := texture_gen();

    shaders := $map(#[
        //$("scan_line", &rl::load_shader(nil, "src/shaders/scan_line.fs")),
        //$("pixelate", &rl::load_shader(nil, "src/shaders/pixelate.fs")),
        $("vignette", &rl::load_shader(nil, "src/shaders/vignette.fs")),
        $("crosshair", &rl::load_shader(nil, "src/shaders/crosshair.fs"))
    ]);

    lighting := rl::load_shader("src/shaders/lighting.vs", "src/shaders/lighting.fs");
    depth_shader := rl::load_shader("src/shaders/depth.vs", "src/shaders/depth.fs");

    camera := Camera3D {
        position = Vector3::new(0, 1.8, -3),
        target = Vector3::new(0, 1.8, 1),
        up = Vector3::new(0, 1, 0),
        fovy = 70,
        projection = CameraProjection::CAMERA_PERSPECTIVE
    };
    
    entities := $map(#[
        $("room", Entity::new(
            &gen_room(), Vector3::new(0, Config::Height / 2, 0),
            Collision::Inside, Visibility::Visible, Lighting::Diffuse,
            0.2, 0.2, 0.5
        )),

        $("door_frame", Entity::new(
            &rl::load_transformed_model(
                "assets/indoor_door_frame.glb",
                Matrix::scale(1.25, 1.25, 1.25)
                    .multiply(Matrix::rotateXYZ(Vector3::new(0, -PI / 2, 0)))),
            Vector3::new(Config::Width / 2, 0.02, 2.5),
            Collision::Outside, Visibility::Visible, Lighting::Diffuse,
            0.2, 0.8, 0.3
        )),
        
        $("door_base", Entity::new(
            door_base := &rl::load_model("assets/indoor_door_base.glb"),
            Vector3::new(Config::Width / 2, 0.02, 2.5),
            Collision::Outside, Visibility::Visible, Lighting::Diffuse,
            0.2, 0.8, 0.3
        )),
        
        $("bed", Entity::new(
            &rl::load_transformed_model(
                "assets/bed4.glb", 
                Matrix::scale(2, 1.5, 1.5)
                    .multiply(Matrix::rotateXYZ(Vector3::new(0, -PI, 0)))
            ), Vector3::new(-2.6, 0.05, 2),
            Collision::Outside, Visibility::Visible, Lighting::Diffuse,
            0.6, 0.3, 0.3
        )),
        
        $("bedside_table", Entity::new(
            &rl::load_transformed_model(
                "assets/bedside_table.glb",
                Matrix::scale(0.5, 0.5, 0.5)
                    .multiply(Matrix::rotateXYZ(Vector3::new(0, -PI, 0)))
            ), Vector3::new(-0.9, 0.05, 3.3),
            Collision::Outside, Visibility::Visible, Lighting::Diffuse,
            0.6, 0.3, 0.3
        )),

        $("light_switch_base", Entity::new(
            &rl::load_transformed_model(
                "assets/light_switch_base.glb",
                Matrix::scale(2, 2, 2)
            ), Vector3::new(1.2, EYE_HEIGHT, -Config::Length / 2),
            Collision::None, Visibility::Visible, Lighting::Diffuse,
            0.2, 0.2, 0.5
        )),
        
        $("light_switch_switch", Entity::new(
            light_switch_switch := &rl::load_transformed_model(
                "assets/light_switch_switch.glb",
                Matrix::scale(2, 2, 2)
            ), Vector3::new(1.2, EYE_HEIGHT, -Config::Length / 2),
            Collision::None, Visibility::Visible, Lighting::Diffuse,
            0.2, 0.2, 0.5
        ))
    ]);
    
    lights := #[
        Light {
            type = LightType::Directional,
            enabled = true,
            dir = Vector3::new(0.35, -1, -0.35).normalize(),
            position = Vector3::new(0, Config::Height - 0.8, 0),
            target = Vector3::zero(),
            color = Vector3::new(1, 0.77, 0.63),
            intensity = 3,
            depthMap = rl::load_shadowmap_render_texture(2048, 2048),
            mat = Matrix::identity()
        },
        Light {
            type = LightType::Point,
            enabled = true,
            dir = Vector3::new(0.35, -1, -0.35).normalize(),
            position = Vector3::new(Config::Width, Config::Height, Config::Length),
            target = Vector3::zero(),
            color = Vector3::new(1, 0.77, 0.63),
            intensity = 1,
            depthMap = rl::load_shadowmap_render_texture(2048, 2048),
            mat = Matrix::identity()
        },
        Light {
            type = LightType::Point,
            enabled = true,
            dir = Vector3::new(0.35, -1, -0.35).normalize(),
            position = Vector3::new(-Config::Width, Config::Height, Config::Length),
            target = Vector3::zero(),
            color = Vector3::new(1, 0.77, 0.63),
            intensity = 1,
            depthMap = rl::load_shadowmap_render_texture(2048, 2048),
            mat = Matrix::identity()
        },
        Light {
            type = LightType::Point,
            enabled = true,
            dir = Vector3::new(0.35, -1, -0.35).normalize(),
            position = Vector3::new(Config::Width, Config::Height, -Config::Length),
            target = Vector3::zero(),
            color = Vector3::new(1, 0.77, 0.63),
            intensity = 1,
            depthMap = rl::load_shadowmap_render_texture(2048, 2048),
            mat = Matrix::identity()
        },
        Light {
            type = LightType::Point,
            enabled = true,
            dir = Vector3::new(0.35, -1, -0.35).normalize(),
            position = Vector3::new(-Config::Width, Config::Height, -Config::Length),
            target = Vector3::zero(),
            color = Vector3::new(1, 0.77, 0.63),
            intensity = 1,
            depthMap = rl::load_shadowmap_render_texture(2048, 2048),
            mat = Matrix::identity()
        }
    ];
    
    sounds := $map(#[
        $("light_on", rl::load_sound("assets/light_on.mp3")),
        $("light_off", rl::load_sound("assets/light_off.mp3")),
        $("door_open", rl::load_sound("assets/door_open.mp3")),
        $("door_close", rl::load_sound("assets/door_close.mp3")),
    ]);

    for entity in entities.values() {
        for i := 0; i < entity.model.materialCount; i += 1 {
            entity.model.materials[i].shader = lighting;
        }
    }

    debug := $map(#[
        $("collisions", true),
        $("free", false),
        $("debug", false),
        $("vignette", true),
        $("lights", true)
    ]);
    
    switchRotation    := 0.0;
    doorRotation      := 0.0;
    doorOpen          := false;
    lightIntensity    := 0.1;
    gameBrightness    := 0.0;

    Animation::new_delayed(&gameBrightness, 0, 255, 2, 3, Easing::inOut);

    shaders["vignette"].set_value("enabled", &debug["vignette"]);
    shaders["crosshair"].set_value("aspect", &(#cast(f32, rl::get_render_width()) / rl::get_render_height()));

    lighting.set_value("lightCount", &#cast(i32, lights.len()));
    lighting.set_value("lightIntensity", &lightIntensity);
    lighting.set_value("lightEnabled", &debug["lights"]);
    lighting.set_value("shadows", &true);
    lighting.set_value("fog", &true);
    swayAmplitude := 0.12;
    swayFrequency := 8.0;
    
    Events::bind();
    
    while !rl::window_should_close() {
        rl::update_music_stream(footsteps);
        pos := camera.position.clone();
        dt := rl::get_frame_time();
        time := rl::get_time();

        rl::update_camera(
            #cast(Camera *, &camera),
            debug["free"] ? CameraMode::CAMERA_FREE : CameraMode::CAMERA_FIRST_PERSON
        );

        camera.up = Vector3::new(0, 1, 0); // keeps camera upright
        lighting.set_value("viewPos", &camera.position);

        light_switch_switch.transform = Matrix::rotateXYZ(Vector3::new(switchRotation, 0, 0))
            .multiply(Matrix::translate(0, 0.06 * (1.0 - math::cosf(switchRotation)), -math::sinf(switchRotation) * 0.07))
            .multiply(Matrix::scale(2, 2, 2));
        
        door_base.transform = Matrix::rotateXYZ(Vector3::new(0, -PI / 2, 0))
            .multiply(Matrix::translate(0, 0, -0.5))
            .multiply(Matrix::rotateXYZ(Vector3::new(0, doorRotation, 0)))
            .multiply(Matrix::translate(0, 0, 0.5))
            .multiply(Matrix::scale(1.25, 1.25, 1.25));
        
        for i := 0; i < animations.len(); i += 1 {
            (&animations[i]).update(dt);
        }
        
        for i := 0; i < lights.len(); i += 1 {
            light_cam := Camera3D {
                position = lights[i].dir.scale(-15),
                target = lights[i].target,
                up = Vector3::new(0, 1, 0),
                fovy = 20,
                projection = CameraProjection::CAMERA_ORTHOGRAPHIC,
            };
            
            lightView := lightProj := Matrix::identity();
            
            rl::begin_texture_mode(lights[i].depthMap);
                rl::clear_background(WHITE);
                rl::begin_mode_3d(light_cam);
                    lightView = rlGetMatrixModelview();
                    lightProj = rlGetMatrixProjection();
                    for entity in entities.values() {
                        if entity.visibility != Visibility::Visible { continue; }
                        rl::draw_model(entity.model, entity.position, 1, WHITE);
                    }
                rl::end_mode_3d();
            rl::end_texture_mode();
            
            lightSpaceMatrix := lightView.multiply(lightProj);

            lighting.set_value("lights[{}].type".format(i), &(+lights[i].type));
            lighting.set_value("lights[{}].dir".format(i), &lights[i].dir);
            lighting.set_value("lights[{}].position".format(i), &lights[i].position);
            lighting.set_value("lights[{}].target".format(i), &lights[i].target);
            lighting.set_value("lights[{}].color".format(i), &lights[i].color);
            lighting.set_value("lights[{}].strength".format(i), &lights[i].intensity);
            lighting.set_value("lights[{}].depthMap".format(i), &lights[i].depthMap.depth);
            lighting.set_value("lights[{}].mat".format(i), &lightSpaceMatrix);
            //lighting.set_value("lights[{}].shadowMap".format(i), &lights[i].depthMap.depth);

            rlEnableShader(lighting.id);
            rlActiveTextureSlot(5 + i);
            rlEnableTexture(lights[i].depthMap.depth.id);

            rlSetUniform(
                rl::get_shader_location(lighting, "lights[{}].shadowMap".format(i)), 
                &(5 + i), ShaderUniformDataType::SHADER_UNIFORM_INT, 1
            );
        }

        if camera.position.sub(pos).length() > 0.001 {
            swayAmplitude = 0.12;
            swayFrequency = 8;
            rl::resume_music_stream(footsteps);
        } else {
            swayAmplitude = 0.002;
            swayFrequency = 0.1;
            rl::pause_music_stream(footsteps);
        }
        
        base := camera.position.clone();
        sway := Vector3::new(
            math::sinf(time * swayFrequency) * swayAmplitude,
            math::cosf(time * swayFrequency * 2.0) * swayAmplitude,
            0,
        );

        camera.position.x = lerp(camera.position.x, base.x + sway.x, 0.1);
        camera.position.y = lerp(camera.position.y, base.y + sway.y, 0.1);

        if debug["collisions"] {
            for entity in entities.values() {
                if entity.collision == Collision::None { continue; }
                camera.collide(pos, entity.bounds, entity.collision);
            }
        }

        if rl::is_key_pressed(KeyboardKey::KEY_TAB) {
            if rl::is_cursor_hidden() { rl::enable_cursor(); }
            else { rl::disable_cursor(); }
        }
        
        if rl::is_key_pressed(KeyboardKey::KEY_ENTER) {
            rl::toggle_fullscreen();
        }

        if rl::is_key_pressed(KeyboardKey::KEY_R) { debug["collisions"] = !debug["collisions"]; }
        if rl::is_key_pressed(KeyboardKey::KEY_P) { debug["debug"] = !debug["debug"]; }
        if rl::is_key_pressed(KeyboardKey::KEY_F) { debug["free"] = !debug["free"]; }
        if rl::is_key_pressed(KeyboardKey::KEY_L) { 
            debug["lights"] = !debug["lights"];
            lighting.set_value("lightEnabled", &#cast(i32, debug["lights"]));
        }

        if rl::is_key_pressed(KeyboardKey::KEY_V) {
            debug["vignette"] = !debug["vignette"];
            shaders["vignette"].set_value("enabled", &debug["vignette"]);
        }
        
        Events::pre_draw();
        
        viewDir := camera.target.sub(camera.position).normalize();
        switchDir := entities["light_switch_base"].position.sub(camera.position); 
        doorDir := entities["door_base"].position.sub(camera.position);
        ray := rl::get_mouse_ray(
            Vector2::new(
                rl::get_screen_width() * 0.5,
                rl::get_screen_height() * 0.5
            ),
            *#cast(Camera *, &camera)
        );
        doorCast := rl::get_ray_collision_box(ray, entities["door_base"].bounds);

        switchHit := switchDir.length_sq() < 4.0 && viewDir.dot(switchDir.normalize()) > 0.98;
        doorHit := doorCast.hit && doorCast.distance < 4;
        
        //$dbg(entities["door_base"].position.sub(camera.position).length_sq(), viewDir.dot(doorDir.normalize()));
        
        if switchHit || doorHit {
            if !Interaction::is_active() {
                events.emit("startInteraction", nil);
            }
            
            if rl::is_key_pressed(KeyboardKey::KEY_E) {
                if switchHit {
                    lightsDisabled := math::fabsf(lightIntensity - 1) < 1.0e-6;
                    lightIntensity = lightsDisabled ? 0.1 : 1;
                    lighting.set_value("lightIntensity", &lightIntensity);
                    lighting.set_value("fog", &#cast(i32, lightsDisabled));
                    Animation::new(&switchRotation, switchRotation, lightsDisabled ? 0 : 1, 0.2, Easing::inOut);
                    rl::play_sound(sounds[lightsDisabled ? "light_on" : "light_off"]);
                } 
                
                if doorHit {
                    doorOpen = !doorOpen;
                    Animation::new(&doorRotation, doorRotation, doorOpen ? -PI / 2 : 0, 1, Easing::softBackOut);
                    rl::play_sound(sounds[doorOpen ? "door_open" : "door_close"]);
                }
            }
        } else if Interaction::is_active() {
            events.emit("stopInteraction", nil);
        }

        rl::begin_texture_mode(front);
            rl::clear_background(BLACK);
            
            rl::begin_mode_3d(camera);
                for entity in entities.values() {
                    if entity.visibility != Visibility::Visible { continue; }
                    lighting.set_value("metallicValue", &entity.metallic);
                    lighting.set_value("roughnessValue", &entity.roughness);
                    lighting.set_value("aoValue", &entity.ao);
                    
                    rl::draw_model(entity.model, entity.position, 1, WHITE);
                }
            rl::end_mode_3d();
        rl::end_texture_mode();

        for shader in shaders.values() {
            rl::begin_texture_mode(back);
                rl::clear_background(BLACK);
                rl::begin_shader_mode(shader);
                    rl::draw_texture_rec(
                        front.texture,
                        Rectangle {
                            x = 0, y = 0,
                            width = front.texture.width,
                            height = -front.texture.height
                        },
                        Vector2::zero(),
                        WHITE
                    );
                rl::end_shader_mode();
            rl::end_texture_mode();

            front, back = $(back, front);
        }
        
        rl::begin_drawing();
            rl::clear_background(BLACK);

            //rl::draw_texture_rec(
            //    lights[0].depthMap.depth,
            //    Rectangle {
            //        x = 0, y = 0,
            //        width = lights[0].depthMap.depth.width,
            //        height = -lights[0].depthMap.depth.height
            //    },
            //    Vector2::zero(),
            //    Color { ..WHITE, a = brightness }
            //);
            
            rl::draw_texture_rec(
                front.texture,
                Rectangle {
                    x = 0, y = 0,
                    width = front.texture.width,
                    height = -front.texture.height
                },
                Vector2::zero(),
                Color { ..WHITE, a = gameBrightness }
            );
            
            Events::draw();
            
            if debug["debug"] {
                rl::draw_text("{}\n\n{}".format(
                    debug, camera,
                    //entities["door_base"].position,
                    //entities["door_base"].position.sub(camera.position),
                    //entities["door_base"].position.sub(camera.position).length_sq(),
                    //viewDir.dot(doorDir.normalize())
                ), 20, 60, 20, WHITE);
            }

            rl::draw_fps(20, 20);
        rl::end_drawing();
    }
}