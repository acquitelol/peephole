use std/prelude;
use std/raylib;

use lib/index;
use models/index;

fn main() {
    rl::init_window(0, 0, "Peephole");
    defer rl::close_window();

    rl::toggle_fullscreen();
    rl::disable_cursor();
    rl::set_target_fps(60);

    texture_gen := fn()
        rl::load_render_texture(
            rl::get_render_width(),
            rl::get_render_height()
        );

    front := texture_gen();
    back := texture_gen();

    shaders := $map(
        $("scan_line", &rl::load_shader(nil, "src/shaders/scan_line.fs")),
        $("pixelate", &rl::load_shader(nil, "src/shaders/pixelate.fs")),
        $("vignette", &rl::load_shader(nil, "src/shaders/vignette.fs")),
        $("crosshair", &rl::load_shader(nil, "src/shaders/crosshair.fs")),
    );

    lighting := rl::load_shader("src/shaders/lighting.vs", "src/shaders/lighting.fs");

    camera := Camera3D {
        position = Vector3::new(0, 1.8, 0),
        target = Vector3::new(0, 1.8, -1),
        up = Vector3::new(0, 1, 0),
        fovy = 70,
        projection = CameraProjection::CAMERA_PERSPECTIVE
    };

    entities := #[
        Entity::new(
            gen_room(), "room",
            Vector3::new(0, Config::Height / 2, 0),
            Collision::Inside, Visibility::Visible, Lighting::Diffuse
        ),

        Entity::new(
            rl::load_model("assets/door.glb"), "door",
            Vector3::new(0, 0.02, -Config::Length / 2 + 0.02),
            Collision::Outside, Visibility::Visible, Lighting::Diffuse
        ),

        Entity::new(
            rl::load_model_from_mesh(rl::gen_mesh_sphere(0.05, 16, 16)), "peephole",
            Vector3::new(0, 2, -Config::Length / 2 + 0.04),
            Collision::None, Visibility::None, Lighting::Diffuse
        )
    ];

    for entity in entities {
        for i := 0; i < entity.model.materialCount; i += 1 {
            entity.model.materials[i].shader = lighting;
        }
    }

    debug := $map(
        $("vignette", true),
        $("fog", true),
        $("shadows", true),
        $("pixelate", false),
        $("collisions", true),
        $("free", false),
        $("debug", false)
    );

    state := $map(
        $("looking_at_peephole", false)
    );

    shaders["vignette"].set_value("enabled", &debug["vignette"]);
    shaders["crosshair"].set_value("aspect", &(#cast(f32, rl::get_render_width()) / rl::get_render_height()));
    shaders["pixelate"].set_value("px", &(4.0 / rl::get_render_width()));
    shaders["pixelate"].set_value("py", &(4.0 / rl::get_render_height()));
    shaders["pixelate"].set_value("enabled", &debug["pixelate"]);
    shaders["scan_line"].set_value("intensity", &0.05);
    shaders["scan_line"].set_value("thickness", &0.001);

    lighting.set_value("shadows", &debug["shadows"]);
    lighting.set_value("fog", &debug["fog"]);
    swayAmplitude := 0.05;
    swayFrequency := 8.0;

    while !rl::window_should_close() {
        pos := camera.position.clone();
        time := rl::get_time();

        rl::update_camera(
            #cast(Camera *, &camera),
            debug["free"] ? CameraMode::CAMERA_FREE : CameraMode::CAMERA_FIRST_PERSON
        );

        camera.up = Vector3::new(0, 1, 0); // keeps camera upright
        lighting.set_value("viewPos", &camera.position);

        if camera.position.sub(pos).length() > 0.001 {
            base := camera.position.clone();
            sway := Vector3::new(
                math::sinf(time * swayFrequency) * swayAmplitude,
                math::cosf(time * swayFrequency * 2.0) * swayAmplitude,
                0,
            );

            camera.position.x = lerp(camera.position.x, base.x + sway.x, 0.1);
            camera.position.y = lerp(camera.position.y, base.y + sway.y, 0.1);
        }

        if debug["collisions"] {
            for entity in entities {
                if entity.collision == Collision::None { continue; }
                camera.collide(pos, entity.bounds, entity.collision);
            }
        }

        if rl::is_key_pressed(KeyboardKey::KEY_TAB) {
            if rl::is_cursor_hidden() { rl::enable_cursor(); }
            else { rl::disable_cursor(); }
        }

        if rl::is_key_pressed(KeyboardKey::KEY_R) { debug["collisions"] = !debug["collisions"]; }
        if rl::is_key_pressed(KeyboardKey::KEY_P) { debug["debug"] = !debug["debug"]; }
        if rl::is_key_pressed(KeyboardKey::KEY_F) { debug["free"] = !debug["free"]; }

        if rl::is_key_pressed(KeyboardKey::KEY_V) {
            debug["vignette"] = !debug["vignette"];
            shaders["vignette"].set_value("enabled", &debug["vignette"]);
        }

        if rl::is_key_pressed(KeyboardKey::KEY_B) {
            debug["fog"] = !debug["fog"];
            lighting.set_value("fog", &debug["fog"]);
        }

        if rl::is_key_pressed(KeyboardKey::KEY_N) {
            debug["shadows"] = !debug["shadows"];
            lighting.set_value("shadows", &debug["shadows"]);
        }

        if rl::is_key_pressed(KeyboardKey::KEY_M) {
            debug["pixelate"] = !debug["pixelate"];
            shaders["pixelate"].set_value("enabled", &debug["pixelate"]);
        }

        rl::begin_texture_mode(front);
            rl::clear_background(BLACK);
            rl::begin_mode_3d(camera);
                for entity in entities {
                    if entity.visibility != Visibility::Visible { continue; }

                    x, y, z := entity.position;
                    lighting.set_value("model", &Matrix::translate(x, y, z));
                    lighting.set_value("specularFactor", &entity.lighting);

                    rl::draw_model(entity.model, entity.position, 1, WHITE);
                }
            rl::end_mode_3d();
        rl::end_texture_mode();

        for shader in shaders.values() {
            rl::begin_texture_mode(back);
                rl::clear_background(BLACK);
                rl::begin_shader_mode(shader);
                    rl::draw_texture_rec(
                        front.texture,
                        Rectangle {
                            x = 0, y = 0,
                            width = front.texture.width,
                            height = -front.texture.height
                        },
                        Vector2::zero(),
                        WHITE
                    );
                rl::end_shader_mode();
            rl::end_texture_mode();

            front, back = $(back, front);
        }

        to_sphere := entities
            .iter()
            .find(fn(x) x.name == "peephole")
            .unwrap()
            .position
            .sub(camera.position);
        distance := to_sphere.length_sq();

        if distance < 4.0 {
            look_dir := camera.target.sub(camera.position).normalize();
            dir_to_sphere := to_sphere.normalize();
            dot := look_dir.dot(dir_to_sphere);

            state["looking_at_peephole"] = dot > 0.995;
            shaders["crosshair"].set_value("interacting", &state["looking_at_peephole"]);
        } else {
            state["looking_at_peephole"] = false;
            shaders["crosshair"].set_value("interacting", &state["looking_at_peephole"]);
        }

        rl::begin_drawing();
            rl::clear_background(BLACK);

            rl::draw_texture_rec(
                front.texture,
                Rectangle {
                    x = 0, y = 0,
                    width = front.texture.width,
                    height = -front.texture.height
                },
                Vector2::zero(),
                WHITE
            );

            if state["looking_at_peephole"] {
                rl::draw_text_centered("Press [E] to look through peephole", rl::get_render_height() - 150, 20, WHITE);
            }

            if debug["debug"] {
                rl::draw_text("{}\n\n{}".format(debug, state), 20, rl::get_render_height() - 200, 20, WHITE);
            }

            rl::draw_fps(20, 20);
        rl::end_drawing();
    }
}