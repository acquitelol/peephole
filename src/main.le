use std/prelude;
use std/raylib;

use lib/index;
use models/index;

fn main() {
    rl::init_window(0, 0, "Peephole");
    defer rl::close_window();

    rl::toggle_fullscreen();
    rl::disable_cursor();
    rl::set_target_fps(60);

    texture_gen := fn()
        rl::load_render_texture(
            rl::get_render_width(),
            rl::get_render_height()
        );

    scene := texture_gen();
    ping := texture_gen();
    pong := texture_gen();

    shaders := $map(
        $("vignette", &rl::load_shader(nil, "src/shaders/vignette.fs")),
        $("crosshair", &rl::load_shader(nil, "src/shaders/crosshair.fs"))
    );

    camera := Camera3D {
        position = Vector3::new(0, 1.8, 0),
        target = Vector3::new(0, 1.8, -1),
        up = Vector3::new(0, 1, 0),
        fovy = 70,
        projection = CameraProjection::CAMERA_PERSPECTIVE
    };

    entities := #[
        Entity::new(
            gen_room("Plaster"), "room",
            Vector3::new(0, Config::Height / 2, 0),
            Collision::Inside, Visibility::Visible
        ),

        Entity::new(
            gen_plane("Planks", true), "floor",
            Vector3::new(0, 0.01, 0),
            Collision::None, Visibility::Visible
        ),

        Entity::new(
            gen_plane("Plaster2", false), "ceiling",
            Vector3::new(0, Config::Height - 0.01, 0),
            Collision::None, Visibility::Visible
        ),

        Entity::new(
            rl::load_model("assets/door.glb"), "door",
            Vector3::new(0, 0.02, -Config::Length / 2 + 0.02),
            Collision::Outside, Visibility::Visible
        ),

        Entity::new(
            rl::load_model_from_mesh(rl::gen_mesh_sphere(0.02, 16, 16)), "peephole",
            Vector3::new(0, 2, -Config::Length / 2 + 0.03),
            Collision::None, Visibility::None
        )
    ];

    debug := $map(
        $("collisions", true),
        $("vignette", true),
        $("free", false)
    );

    state := $map(
        $("looking_at_peephole", false)
    );

    shaders["vignette"].set_value("enabled", &debug["vignette"]);
    shaders["crosshair"].set_value("aspect", &(#cast(f32, rl::get_render_width()) / rl::get_render_height()));

    while !rl::window_should_close() {
        pos := camera.position.clone();

        rl::update_camera(
            #cast(Camera *, &camera),
            debug["free"] ? CameraMode::CAMERA_FREE : CameraMode::CAMERA_FIRST_PERSON
        );

        camera.up = Vector3::new(0, 1, 0);  // keeps camera upright

        if debug["collisions"] {
            for entity in entities {
                if entity.collision != Collision::None {
                    camera.collide(pos, entity.bounds, entity.collision);
                }
            }
        }

        if rl::is_key_pressed(KeyboardKey::KEY_TAB) {
            if rl::is_cursor_hidden() { rl::enable_cursor(); }
            else { rl::disable_cursor(); }
        }

        if rl::is_key_pressed(KeyboardKey::KEY_R) { debug["collisions"] = !debug["collisions"]; }
        if rl::is_key_pressed(KeyboardKey::KEY_F) { debug["free"] = !debug["free"]; }
        if rl::is_key_pressed(KeyboardKey::KEY_V) {
            debug["vignette"] = !debug["vignette"];
            shaders["vignette"].set_value("enabled", &debug["vignette"]);
        }

        rl::begin_texture_mode(scene);
            rl::clear_background(BLACK);
            rl::begin_mode_3d(camera);
                for entity in entities {
                    if entity.visibility == Visibility::Visible {
                        rl::draw_model(entity.model, entity.position, 1, WHITE);
                    }
                }
            rl::end_mode_3d();
        rl::end_texture_mode();

        src, dst := $(&scene, &ping);

        for shader in shaders.values() {
            rl::begin_texture_mode(*dst);
                rl::clear_background(BLACK);
                rl::begin_shader_mode(shader);
                    rl::draw_texture_rec(
                        src.texture,
                        Rectangle {
                            x = 0, y = 0,
                            width = src.texture.width,
                            height = -src.texture.height
                        },
                        Vector2::zero(),
                        WHITE
                    );
                rl::end_shader_mode();
            rl::end_texture_mode();

            src, dst = $(dst, src);
        }

        to_sphere := entities
            .iter()
            .find(fn(x) x.name == "peephole")
            .unwrap()
            .position
            .sub(camera.position);
        distance := to_sphere.length_sq();

        if distance < 4.0 {
            look_dir := camera.target.sub(camera.position).normalize();
            dir_to_sphere := to_sphere.normalize();
            dot := look_dir.dot(dir_to_sphere);

            state["looking_at_peephole"] = dot > 0.999;
            shaders["crosshair"].set_value("interacting", &state["looking_at_peephole"]);
        } else {
            state["looking_at_peephole"] = false;
            shaders["crosshair"].set_value("interacting", &state["looking_at_peephole"]);
        }

        rl::begin_drawing();
            rl::clear_background(BLACK);

            rl::draw_texture_rec(
                src.texture,
                Rectangle {
                    x = 0, y = 0,
                    width = src.texture.width,
                    height = -src.texture.height
                },
                Vector2::zero(),
                WHITE
            );

            if state["looking_at_peephole"] {
                rl::draw_text_centered("Press [E] to look through peephole", rl::get_render_height() - 150, 20, WHITE);
            }

            rl::draw_text("{}\n\n{}".format(debug, state), 20, rl::get_render_height() - 160, 20, WHITE);
            rl::draw_fps(20, 20);
        rl::end_drawing();
    }
}