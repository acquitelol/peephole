use std/prelude;
use std/raylib;

use bindings;
use entity;
global pub;

enum Config {
    Width = 8,
    Height = 4,
    Length = 8
}

let PLAYER_RADIUS = 0.5;
let EYE_HEIGHT = 1.8;

fn Camera3D::collide(Camera3D *self, Vector3 prev, BoundingBox bounds, Collision collision) {
    move := self.position.sub(prev);

    test := prev.clone();
    test.x += move.x;
    hit_x := false;

    if collision == Collision::Inside {
        hit_x = test.x - PLAYER_RADIUS < bounds.min.x
            || test.x + PLAYER_RADIUS > bounds.max.x;
    } else if collision == Collision::Outside {
        hit_x = test.x + PLAYER_RADIUS > bounds.min.x
            && test.x - PLAYER_RADIUS < bounds.max.x
            && prev.z + PLAYER_RADIUS > bounds.min.z
            && prev.z - PLAYER_RADIUS < bounds.max.z;
    } else {
        $die();
    }

    if hit_x { move.x = 0; }

    test := prev.clone();
    test.z += move.z;
    hit_z := false;

    if collision == Collision::Inside {
        hit_z = test.z - PLAYER_RADIUS < bounds.min.z
            || test.z + PLAYER_RADIUS > bounds.max.z;
    } else if collision == Collision::Outside {
        hit_z = test.z + PLAYER_RADIUS > bounds.min.z
            && test.z - PLAYER_RADIUS < bounds.max.z
            && prev.x + PLAYER_RADIUS > bounds.min.x
            && prev.x - PLAYER_RADIUS < bounds.max.x;
    } else {
        $die();
    }

    if hit_z { move.z = 0; }

    next := prev.add(move);

    if collision == Collision::Inside {
        if next.y < EYE_HEIGHT { next.y = EYE_HEIGHT; }
        if next.y > bounds.max.y - 0.01 { next.y = bounds.max.y - 0.01; }
    }

    view := self.target.sub(self.position);
    self.position = next;
    self.target = self.position.add(view);
}

fn lerp(f32 a, f32 b, f32 t) {
    return a + (b - a) * t;
}

fn rl::load_shadowmap_render_texture(i32 width, i32 height) {
    target := RenderTexture2D {};

    target.id = rlLoadFramebuffer();
    target.texture.width = width;
    target.texture.height = height;

    rlEnableFramebuffer(target.id);

    target.depth.id = rlLoadTextureDepth(width, height, false);
    target.depth.width = width;
    target.depth.height = height;
    target.depth.format = 19; // DEPTH_COMPONENT_24BIT?
    target.depth.mipmaps = 1;

    rlFramebufferAttach(target.id, target.depth.id, RL::ATTACHMENT_DEPTH, RL::ATTACHMENT_TEXTURE2D, 0);
    rlDisableFramebuffer();

    return target;
}

external fn scale_model_uv(Model *model, i32 **s);